{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npx sanity build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/posthog-api/:route", "destination": "/api/posthog-api?route=:route" },
    { "source": "/support-api", "destination": "/api/support-admin" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
