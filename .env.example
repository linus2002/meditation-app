# Copy to .env.local and fill in from Supabase: the "Connect" button at the top
# of your project, or Settings -> API Keys.
#
# Both are baked into the build (web and mobile). The publishable key is public
# by design; what protects the data is row level security in
# supabase/migrations. A legacy anon key also works, as
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Leave them empty and the app still builds -
# Circles simply shows as unavailable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cancer support track. Leave empty in production until a qualified clinician
# has signed off the wording (see the README); set to 1 to build and test it.
NEXT_PUBLIC_SUPPORT_TRACK=

# PostHog product analytics and session replay (see src/lib/analytics.ts).
# Project settings -> Project API key, which starts with phc_ and is public by
# design. Use https://eu.i.posthog.com as the host for an EU project. Leave the
# key empty and analytics is switched off entirely. Nothing is sent until the
# reader allows it on the consent card or the Profile toggle.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Kapwa AI replies. Leave empty and Kapwa uses its built-in keyword replies.
#   local  Ollama running on this computer: no key, no cloud. Development and
#          demos only, since real users' phones can't reach your computer.
#   1      Ollama Cloud through the kapwa-chat edge function, once it is
#          deployed with its OLLAMA_API_KEY secret (see the README). The key
#          never goes here or into the app.
NEXT_PUBLIC_KAPWA_AI=
# Local mode only. The model must be pulled (ollama pull qwen2.5:3b). The URL
# defaults to port 11434 on whatever host served the page. THREADS caps the
# CPU cores the model uses, so the computer stays responsive (empty = Ollama
# decides; 6 suits a 10-core laptop).
NEXT_PUBLIC_KAPWA_LOCAL_MODEL=qwen2.5:3b
NEXT_PUBLIC_KAPWA_LOCAL_THREADS=
NEXT_PUBLIC_KAPWA_LOCAL_URL=

# Digits in the sign-in code email. Must match Supabase -> Authentication ->
# Email -> "Email OTP Length". Defaults to 6.
NEXT_PUBLIC_AUTH_CODE_LENGTH=6
