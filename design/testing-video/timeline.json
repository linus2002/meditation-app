 "vo": [
  {
   "id": "welcome",
   "at": 15.95,
   "dur": 10.255,
   "text": "Hello, everyone! Serenity, our meditation and wellbeing app, is now open for internal testing at Getmeds Incorporated and 2MG Incorporated."
  },
  {
   "id": "benefits",
   "at": 27.005,
   "dur": 6.552,
   "text": "It helps you manage stress, sleep better, and build healthier routines. And during testing, it's completely free."
  },
  {
   "id": "install",
   "at": 34.357,
   "dur": 10.201,
   "text": "To install it, open the link in this announcement. On Android, download and install the app. On iPhone, open it in Safari and add Serenity to your Home Screen."
  },
  {
   "id": "meditate",
   "at": 45.358,
   "dur": 4.691,
   "text": "Inside, you'll find guided meditations, programs, and a meditation timer,"
  },
  {
   "id": "breathe",
   "at": 50.269,
   "dur": 3.507,
   "text": "breathing exercises like box breathing and four-seven-eight,"
  },
  {
   "id": "sleep",
   "at": 53.996,
   "dur": 2.696,
   "text": "sleep stories, ambient sounds, and a sleep timer,"
  },
  {
   "id": "yoga",
   "at": 56.912,
   "dur": 2.053,
   "text": "and gentle, voice-guided yoga."
  },
  {
   "id": "kapwa",
   "at": 59.765,
   "dur": 6.846,
   "text": "Talk to Kapwa, your wellness companion, in English, Filipino, or Hindi. Filipino and Hindi are still in beta."
  },
  {
   "id": "track",
   "at": 67.411,
   "dur": 9.329,
   "text": "Track your mood, your goals, and a gentle streak, and see your monthly insights. Plus reflections, favorites, sound mixes, offline downloads, and reminders."
  },
  {
   "id": "test",
   "at": 77.54,
   "dur": 7.438,
   "text": "Please test everything: the features, the design, the speed, the content, Kapwa's replies, and how it runs on your phone."
  },
  {
   "id": "feedback",
   "at": 85.778,
   "dur": 8.078,
   "text": "To send feedback, go to Profile, Help and Support, then Raise a Concern. Describe it, attach up to three screenshots, and submit."
  },
  {
   "id": "shots",
   "at": 94.656,
   "dur": 5.008,
   "text": "Keep screenshots original and full-screen, and leave out passwords or private details."
  },
  {
   "id": "it",
   "at": 100.464,
   "dur": 4.742,
   "text": "The IT Department reviews every message, and will reply right in the app."
  },
  {
   "id": "close",
   "at": 106.006,
   "dur": 7.216,
   "text": "No experience needed. Explore at your own pace, and tell us honestly what you think. Let's make Serenity better, together!"
  }
 ],
